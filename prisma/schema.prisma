generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Instalacoes{
  id Int @id @default(autoincrement())
  id_cliente Int
  clientes Clientes @relation(fields: [id_cliente], references: [id], onDelete: Cascade)
  id_cyber Int
  cyber Cyberwares @relation(fields: [id_cyber], references: [id], onDelete: Cascade)
  data DateTime @default(now())
}

enum Tipo {
  CLIENTE
  ADMIN
}

model Clientes {
  id                Int           @id @default(autoincrement())
  nome              String 
  email             String        @unique
  senha             String        
  tipo              Tipo          @default(CLIENTE)
  saldo             Decimal 
  codigoRecuperacao String?       @db.VarChar(4)
  ultimoLogin       DateTime?
  instalacoes       Instalacoes[]
  logs              Log[]         
}

model Cyberwares{
  id Int @id @default(autoincrement())
  nome String 
  preco    Decimal
  estoque  String
  intalacoes Instalacoes[]
  id_categoria Int
  categoria Categoria @relation(fields: [id_categoria], references: [id])
}

model Categoria {
  id Int @id @default(autoincrement())
  nome String @unique
  cyberware Cyberwares[] 
}

model HistoricoVendas {
  id                Int      @id @default(autoincrement())
  data_procedimento DateTime @default(now())
  nome_cliente      String   
  email_cliente     String   
  nome_cyberware    String   
  valor_pago        Decimal  @db.Decimal(10, 2)
  @@map("historico_vendas") 
}

model Log {
  id          Int      @id @default(autoincrement())
  descricao   String
  complemento String?
  createdAt   DateTime @default(now())
  clienteId   Int?      
  cliente     Clientes? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  
  @@map("logs")
}